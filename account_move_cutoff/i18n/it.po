#. module: account_move_cutoff
#: model_terms:ir.ui.view,arch_db:account_move_cutoff.res_config_settings_view_form
msgid ""
"- <strong>Equal</strong>: splits the total evenly over the entire service "
"period,\n"
"                                based on the start and end dates of the "
"invoice line."
msgstr ""
"- <strong>Uguale</strong>: suddivide il totale in parti uguali sull'intero "
"periodo di servizio,\n"
"                                in base alle date di inizio e fine della "
"riga fattura."

#. module: account_move_cutoff
#: model_terms:ir.ui.view,arch_db:account_move_cutoff.res_config_settings_view_form
msgid ""
"- <strong>Prorata temporis (by month %)</strong>: allocates the amount "
"proportionally\n"
"                                to the number of service days in each month."
msgstr ""
"- <strong>Pro rata temporis (% per mese)</strong>: ripartisce l'importo "
"proporzionalmente\n"
"                                al numero di giorni di servizio in ciascun "
"mese."

