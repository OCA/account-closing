<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='accounting_reports']" position="after">
                <block title="Account Start/End Dates" id="account_start_end_dates">
                    <setting
                        id="apply_dates_all_lines"
                        help="Set start and end date to all account move lines, including those without product or with product not enabled to start/end dates."
                    >
                        <field name="apply_dates_all_lines" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
