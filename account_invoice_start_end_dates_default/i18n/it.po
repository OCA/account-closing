#. module: account_invoice_start_end_dates_default
#: model:ir.model.fields,field_description:account_invoice_start_end_dates_default.field_res_company__start_end_dates_from_invoice_date
#: model:ir.model.fields,field_description:account_invoice_start_end_dates_default.field_res_config_settings__start_end_dates_from_invoice_date
