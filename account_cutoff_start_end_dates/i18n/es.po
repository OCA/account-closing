msgstr "Importe pendiente"

#. module: account_cutoff_start_end_dates
#: model:ir.model.fields,field_description:account_cutoff_start_end_dates.field_account_cutoff_tax_line__pending_base
msgid "Pending Base"
msgstr "Base pendiente"

