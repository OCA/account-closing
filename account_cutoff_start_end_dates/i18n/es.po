#: model:ir.model.fields,field_description:account_cutoff_start_end_dates.field_account_cutoff_tax_line__pending_cutoff_amount
msgid "Pending Cutoff Amount"
msgstr "Importe de cierre pendiente"

#. module: account_cutoff_start_end_dates
#: model:ir.model.fields,field_description:account_cutoff_start_end_dates.field_account_cutoff__previous_cutoff_id
msgid "Previous Cutoff"
msgstr "Cierre anterior"

#. module: account_cutoff_start_end_dates
#: model:ir.model.fields,field_description:account_cutoff_start_end_dates.field_account_cutoff_line__previous_pending_amount
msgid "Previous Pending Amount"
msgstr "Importe pendiente anterior"

#. module: account_cutoff_start_end_dates
#. odoo-python
#: code:addons/account_cutoff_start_end_dates/models/account_cutoff.py:0
msgid "Reset dependent cut-offs to draft first."
msgstr "Primero devuelva a borrador los cierres dependientes."

#. module: account_cutoff_start_end_dates
#. odoo-python
#: code:addons/account_cutoff_start_end_dates/models/account_cutoff.py:0
msgid "The previous cut-off changed. Generate the lines again."
msgstr "El cierre anterior ha cambiado. Vuelva a generar las líneas."

#. module: account_cutoff_start_end_dates
#. odoo-python
#: code:addons/account_cutoff_start_end_dates/models/account_cutoff.py:0
msgid "The previous difference cut-off must not be reversed."
msgstr "El cierre anterior por diferencias no debe estar revertido."

#. module: account_cutoff_start_end_dates
#. odoo-python
#: code:addons/account_cutoff_start_end_dates/models/account_cutoff.py:0
msgid "The previous regular cut-off must have a posted reversal dated on or before this cut-off to start from zero."
msgstr "Para empezar desde cero, el cierre anterior del modo habitual debe tener una reversión contabilizada con fecha anterior o igual a la de este cierre."
