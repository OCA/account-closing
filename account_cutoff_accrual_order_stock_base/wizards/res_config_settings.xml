<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">cutoff.res.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='dft_prepaid_revenue_account_id']" position="after">
                <div class="row" id="dft_prepaid_revenue_account_id">
                    <label
                        for="dft_stock_prepaid_revenue_account_id"
                        class="col-md-5"
                    />
                    <field
                        name="dft_stock_prepaid_revenue_account_id"
                        options="{'no_create_edit': True, 'no_open': True}"
                    />
                </div>
            </xpath>
            <xpath expr="//div[@id='dft_prepaid_expense_account_id']" position="after">
                <div class="row" id="dft_prepaid_expense_account_id">
                    <label
                        for="dft_stock_prepaid_expense_account_id"
                        class="col-md-5"
                    />
                    <field
                        name="dft_stock_prepaid_expense_account_id"
                        options="{'no_create_edit': True, 'no_open': True}"
                    />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
