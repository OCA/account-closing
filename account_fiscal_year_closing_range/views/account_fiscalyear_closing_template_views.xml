<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_account_fiscalyear_closing_template_form_range" model="ir.ui.view">
        <field name="name">account.fiscalyear.closing.template.form.range</field>
        <field name="model">account.fiscalyear.closing.template</field>
        <field
            name="inherit_id"
            ref="account_fiscal_year_closing.view_account_fiscalyear_closing_template_form"
        />
        <field name="arch" type="xml">

            <xpath
                expr="//field[@name='move_config_ids']/form//group[@name='accounts_mapping']"
                position="before"
            >
                <div
                    class="alert alert-info d-flex justify-content-between align-items-center mb-0"
                    role="alert"
                >
                    <div>
                        <i class="fa fa-info-circle mr-2" />
                        Use the wizard to generate individual mapping lines for a specific range of accounts.
                    </div>
                    <button
                        name="%(account_fiscal_year_closing_range.action_account_fiscalyear_closing_mapping_range_wizard)d"
                        type="action"
                        string="Generate Range"
                        icon="fa-magic"
                        class="btn-primary"
                        context="{'default_fyc_config_template_id': active_id}"
                    />
                </div>
            </xpath>

        </field>
    </record>

</odoo>
