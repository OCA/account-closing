<odoo>
    <record
        id="view_account_fiscalyear_closing_mapping_range_wizard_form"
        model="ir.ui.view"
    >
        <field name="name">fiscalyear.closing.range.wizard.form</field>
        <field name="model">fiscalyear.closing.range.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Account Range Mappings">
                <div class="alert alert-info" role="alert" style="margin-bottom: 20px;">
                    <i class="fa fa-info-circle mr-2" />
                    This wizard creates individual mapping lines for
                    <strong>every account</strong> found within the specified range.
                    Ideal for mapping entire groups of accounts to a single result.
                </div>

                <field name="fyc_config_id" invisible="1" />
                <field name="fyc_config_template_id" invisible="1" />
                <field name="company_id" invisible="1" />

                <group>
                    <group string="Source Range">
                        <label for="account_start_id" string="Account Range" />
                        <div class="o_row">
                            <field
                                name="account_start_id"
                                placeholder="e.g. 1.1.01.001"
                                required="1"
                            />
                            <span>to</span>
                            <field
                                name="account_end_id"
                                placeholder="e.g. 1.1.01.999"
                                required="1"
                            />
                        </div>
                        <field name="name_prefix" placeholder="e.g. Closing" />
                    </group>

                    <group string="Destination">
                        <field
                            name="dest_account_id"
                            placeholder="e.g. 3.1.01.001 - Account Name"
                            required="fyc_config_id"
                            invisible="not fyc_config_id"
                            help="The account where the balance will be transferred to."
                        />
                        <field
                            name="dest_account_code"
                            placeholder="e.g. 3.1.01.001"
                            required="not fyc_config_id"
                            invisible="fyc_config_id"
                            help="The account code where the balance will be transferred to."
                        />
                    </group>
                </group>

                <notebook>
                    <page string="Accounts to be Mapped" name="preview_accounts">
                        <field
                            name="preview_account_ids"
                            nolabel="1"
                            readonly="1"
                            force_save="1"
                        >
                            <list decoration-info="1">
                                <field name="code" />
                                <field name="name" />
                            </list>
                        </field>
                    </page>
                </notebook>

                <footer>
                    <button
                        name="action_apply"
                        type="object"
                        string="Generate Mappings"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button
                        string="Discard"
                        class="btn-secondary"
                        special="cancel"
                        data-hotkey="z"
                    />
                </footer>
            </form>
        </field>
    </record>
</odoo>
