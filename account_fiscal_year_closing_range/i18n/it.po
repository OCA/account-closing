msgid ""
"<i class=\"fa fa-exclamation-triangle mr-2\"/>\n"
"                    Please save the template first before using the range "
"wizard."
msgstr ""
"<i class=\"fa fa-exclamation-triangle mr-2\"/>\n"
"                    Si prega di salvare il modello prima di utilizzare la "
"procedura guidata per l'intervallo."

#. module: account_fiscal_year_closing_range
#: model_terms:ir.ui.view,arch_db:account_fiscal_year_closing_range.view_account_fiscalyear_closing_form_range
