msgid ""
"<i class=\"fa fa-info-circle mr-2\"/>\n"
"                        Use the wizard to generate individual mapping lines "
"for a specific range of accounts."
msgstr ""
"<i class=\"fa fa-info-circle mr-2\"/>\n"
"                        Utilizzare la procedura guidata per generare singole "
"righe di mappatura per un intervallo specifico di conti."

#. module: account_fiscal_year_closing_range
#: model_terms:ir.ui.view,arch_db:account_fiscal_year_closing_range.view_account_fiscalyear_closing_mapping_range_wizard_form
msgid ""
"<i class=\"fa fa-info-circle mr-2\"/>\n"
"                    This wizard creates individual mapping lines for\n"
"                    <strong>every account</strong> found within the "
"specified range.\n"
"                    Ideal for mapping entire groups of accounts to a single "
"result."
msgstr ""
"<i class=\"fa fa-info-circle mr-2\"/>\n"
"                   Questa procedura guidata crea linee di mappatura "
"individuali per\n"
"                   <strong>ogni conto</strong> trovato nell'intervallo "
"specificato.\n"
"                   Ideale per mappare interi gruppi di conti in un singolo "
"risultato."

